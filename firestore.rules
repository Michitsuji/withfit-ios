rules_version = '2';

// WithFit Firestore セキュリティルール
// 方針:
// - アプリのデータ（artifacts/withfit-app/public/data 配下）は「ログイン済み
//   セッションがある場合のみ」読み書き可。未認証の第三者からは一切触れない。
// - private 配下はクライアントからは読み書き不可（サーバーの Admin SDK 専用）。
// - それ以外は全て拒否。
// 注意: これは第一段階の締め付け。ユーザー単位の厳密な所有権チェックは、
// フレンドコードログインのカスタムトークン化（uid = ユーザー名）が全員に
// 行き渡った後に第二段階として導入する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /artifacts/{appId}/private/data/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
